{
  "name": "ant-short-tv",
  "private": true,
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:start": "npm --prefix frontend start",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:test": "npm --prefix frontend run test",
    "frontend:build": "npm --prefix frontend run build",
    "backend:run": "mvn -f backend/pom.xml spring-boot:run",
    "backend:test": "mvn -f backend/pom.xml test",
    "test": "npm run frontend:test && npm run backend:test",
    "lint": "npm run frontend:lint"
  }
