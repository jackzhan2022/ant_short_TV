.library { margin-top: 48rpx; }
.section-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.count { color: #929aab; font-size: 24rpx; }
.drama-card { display: flex; width: 100%; padding: 28rpx; margin-bottom: 22rpx; text-align: left; background: #fff; border-radius: 24rpx; line-height: 1.5; }
.tile { width: 110rpx; height: 144rpx; flex-shrink: 0; border-radius: 16rpx; background: #edf0fc; color: #5267cc; display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 600; }
.card-content { flex: 1; min-width: 0; padding-left: 26rpx; }
.card-title { font-size: 32rpx; font-weight: 600; color: #192334; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-description { color: #7a8494; font-size: 24rpx; margin-top: 10rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.watch { margin-top: 18rpx; color: #5267cc; font-size: 24rpx; }
