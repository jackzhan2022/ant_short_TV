# Copy this file to env and replace placeholders with real values.
# env is ignored by git and should contain your local/online credentials.

# MySQL
MYSQL_URL=jdbc:mysql://YOUR_HOST:3306/ant_short_tv?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=YOUR_USERNAME
MYSQL_PASSWORD=YOUR_PASSWORD

# AI secret used by backend encryption/decryption
AI_SECRET_KEY=YOUR_AI_SECRET_KEY

# Shared outbound request limit for each AI provider account.
AI_PROVIDER_MAX_CONCURRENCY=4

# Short-drama analysis Agents run automatically; configure concurrency only.
AI_WORKFLOW_FANOUT_CONCURRENCY=3

# Persistent generated review exports (use an absolute shared path in production)
REVIEW_EXPORT_ROOT=storage/review-exports

# Tencent Cloud SMS registration verification
TENCENT_SMS_SECRET_ID=YOUR_SECRET_ID
TENCENT_SMS_SECRET_KEY=YOUR_SECRET_KEY
TENCENT_SMS_SDK_APP_ID=YOUR_SMS_SDK_APP_ID
TENCENT_SMS_SIGN_NAME=YOUR_SMS_SIGN_NAME
TENCENT_SMS_REGISTER_TEMPLATE_ID=YOUR_REGISTER_TEMPLATE_ID
TENCENT_SMS_REGION=ap-guangzhou

# Episode splitting: full script first, persisted chunk fallback on capacity failures
AI_WORKFLOW_SPLIT_SAFE_CONTEXT_TOKENS=800000
AI_WORKFLOW_SPLIT_PROMPT_RESERVE_TOKENS=12000
AI_WORKFLOW_SPLIT_TOOL_RESERVE_TOKENS=24000
AI_WORKFLOW_SPLIT_CHUNK_TARGET_MIN=15000
AI_WORKFLOW_SPLIT_CHUNK_TARGET_MAX=20000
AI_WORKFLOW_SPLIT_CHUNK_HARD_MAX=24000
AI_WORKFLOW_SPLIT_CHUNK_OVERLAP=1500
AI_WORKFLOW_SPLIT_CHUNK_CONCURRENCY=3

# Server-side session token pepper (at least 32 characters; keep stable across restarts)
AUTH_TOKEN_PEPPER=YOUR_AUTH_TOKEN_PEPPER_AT_LEAST_32_CHARS

# Tencent COS + private CDN. Backend credentials come from the attached CAM instance role.
OBJECT_STORAGE_BUCKET=antv-1418200553
OBJECT_STORAGE_REGION=ap-guangzhou
OBJECT_STORAGE_CLASS=INTELLIGENT_TIERING
OBJECT_STORAGE_CDN_DOMAIN=https://antvcdn.aixmax.cn
OBJECT_STORAGE_CDN_TYPE_D_KEY=YOUR_CDN_TYPE_D_KEY
# Must match the CDN Type D lifetime; the domain uses SHA256 and hexadecimal t.
OBJECT_STORAGE_CDN_TYPE_D_EXPIRY_SECONDS=604800
OBJECT_STORAGE_CDN_AUTHORIZATION_SECONDS=604800
OBJECT_STORAGE_VIDEO_RENEWAL_THRESHOLD_SECONDS=7200
OBJECT_STORAGE_UPLOAD_SIGNATURE_SECONDS=300
OBJECT_STORAGE_CI_CALLBACK_URL=https://YOUR_PUBLIC_HOST/api/media-processing/callbacks/tencent-ci

# WeChat Pay API v3 Native payment
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://YOUR_PUBLIC_HOST/api/commercial/payments/wechat/notify

# 微信平台型第三方授权；默认禁用，禁止填写真实凭据到示例文件。
WECHAT_COMPONENT_ENABLED=false
WECHAT_COMPONENT_APPID=
WECHAT_COMPONENT_SECRET=
WECHAT_COMPONENT_EVENT_TOKEN=
WECHAT_COMPONENT_ENCODING_AES_KEY=
# 独立随机32字节密钥的Base64编码，仅存服务端环境；保持稳定。
WECHAT_COMPONENT_MASTER_KEY=
WECHAT_COMPONENT_CALLBACK_URL=https://YOUR_PUBLIC_HOST/api/wechat/component/callback
# 开放平台授权事件接收URL：https://YOUR_PUBLIC_HOST/api/wechat/component/events
# 消息与事件接收URL：https://YOUR_PUBLIC_HOST/api/wechat/component/messages/$APPID$
# GET signature校验三参数后原样echo；兼容msg_signature密文echo，验签解密后回显，禁止失败降级。
# 第三方官方文档规定POST安全模式XML；密文GET兼容不代表第三方平台强制采用企业微信GET协议。
# POST必须msg_signature验签，AES尾部验证第三方APPID，不以signature替代密文验签。
# 路径APPID必须已有团队正式授权，ToUserName逐次调用官方账号信息user_name核实；未知/撤销/跨应用拒绝。
# 官方账号信息不可用时拒绝接收；当前未持久化原始ID，未提供异步队列或客服回复的时延保证。
# 普通消息仅安全接收后空回复；debug_demo验签校验后确认；未实现客服、被动回复或业务事件处理。
# 全网发布专用测试号及TESTCOMPONENT/QUERY_AUTH_CODE测试不支持，明确拒绝，不假返回success。
