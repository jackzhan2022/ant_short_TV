# Copy this file to env and replace placeholders with real values.
# env is ignored by git and should contain your local/online credentials.

# MySQL
MYSQL_URL=jdbc:mysql://YOUR_HOST:3306/ant_short_tv?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=YOUR_USERNAME
MYSQL_PASSWORD=YOUR_PASSWORD

# AI secret used by backend encryption/decryption
AI_SECRET_KEY=YOUR_AI_SECRET_KEY

# Server-side session token pepper (at least 32 characters; keep stable across restarts)
AUTH_TOKEN_PEPPER=YOUR_AUTH_TOKEN_PEPPER_AT_LEAST_32_CHARS

# Object storage
OBJECT_STORAGE_MODE=s3
OBJECT_STORAGE_ENDPOINT=https://YOUR_OBJECT_STORAGE_ENDPOINT
OBJECT_STORAGE_BUCKET=ant-short-tv
OBJECT_STORAGE_ACCESS_KEY=YOUR_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=YOUR_SECRET_KEY
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
