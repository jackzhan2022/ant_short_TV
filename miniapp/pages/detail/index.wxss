.intro {
  display:flex;
  gap:28rpx}
.detail-poster {
  width:230rpx;
  height:326rpx;
  border-radius:22rpx;
  background:#e6eaf2}
.intro-info {
  flex:1;
  min-width:0;
  padding-top:12rpx}
.intro-info .heading {
  font-size:40rpx;
  margin-bottom:24rpx}
.intro-info .muted {
  margin-bottom:14rpx}
.synopsis {
  color:#59657b;
  line-height:1.9;
  white-space:pre-wrap}
.collapsed {
  display:-webkit-box;
  -webkit-line-clamp:3;
  -webkit-box-orient:vertical;
  overflow:hidden}
.expand {
  color:#5265eb;
  padding:16rpx 0 32rpx}
.section-title .muted {
  font-weight:400;
  font-size:21rpx}

