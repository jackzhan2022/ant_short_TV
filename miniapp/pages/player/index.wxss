page {
  background:#050608;
  color:#fff;
  height:100%;
  overflow:hidden}
.player,.viewport {
  position:relative;
  height:100vh;
  width:100%;
  background:#050608}
.screen {
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center}
.video {
  width:100%;
  height:100%}
.poster {
  opacity:.6}
.topbar {
  position:absolute;
  top:0;
  left:0;
  right:0;
  display:flex;
  gap:18rpx;
  align-items:center;
  padding:0 190rpx 20rpx 26rpx;
  background:linear-gradient(#0008,transparent);
  pointer-events:none}
.back {
  width:70rpx;
  height:70rpx;
  line-height:60rpx;
  font-size:70rpx;
  pointer-events:auto}
.top-title {
  font-size:27rpx;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis}
.center-status {
  position:absolute;
  left:0;
  right:0;
  top:44%;
  text-align:center;
  color:#ddd;
  font-size:26rpx;
  pointer-events:none;
  text-shadow:0 2rpx 8rpx #000}
.play {
  position:absolute;
  top:42%;
  left:calc(50% - 60rpx);
  width:120rpx;
  height:120rpx;
  line-height:110rpx;
  text-align:center;
  font-size:100rpx;
  color:#fff9;
  text-shadow:0 4rpx 16rpx #0006}
.bottom-panel {
  position:absolute;
  bottom:0;
  left:0;
  right:0;
  padding:90rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background:linear-gradient(transparent,#000c);
  text-shadow:0 2rpx 6rpx #000;
  pointer-events:none}
.title {
  font-size:34rpx;
  font-weight:600;
  max-width:100%;
  overflow:hidden;
  white-space:nowrap;
  text-overflow:ellipsis}
.episode-no {
  font-size:26rpx;
  font-weight:400;
  margin-left:18rpx}
.episode-title {
  font-size:24rpx;
  opacity:.75;
  margin:6rpx 0 24rpx}
.tools {
  display:flex;
  align-items:center;
  gap:30rpx;
  font-size:25rpx;
  pointer-events:auto}
.tools>view {
  min-height:88rpx;
  display:flex;
  align-items:center}
.select-button {
  margin-left:auto;
  background:#fff2;
  border-radius:14rpx;
  padding:0 18rpx}
.timeline {
  display:flex;
  align-items:center;
  font-size:21rpx;
  gap:10rpx;
  margin-top:12rpx;
  pointer-events:auto}
.timeline slider {
  flex:1;
  margin:12rpx 8rpx}
.gesture-hint {
  text-align:center;
  color:#ffffff75;
  font-size:20rpx;
  margin-top:12rpx}
.exit-clean,.quick-select {
  position:absolute;
  right:28rpx;
  bottom:calc(24rpx + env(safe-area-inset-bottom));
  background:#0006;
  border:1rpx solid #fff5;
  border-radius:30rpx;
  padding:16rpx 24rpx;
  font-size:24rpx}
.error-card {
  position:absolute;
  top:36%;
  left:54rpx;
  right:54rpx;
  text-align:center;
  background:#181b24ed;
  padding:38rpx 28rpx;
  border-radius:24rpx}
.error-card button {
  background:#7486ff;
  color:#fff;
  margin:28rpx auto 0;
  width:260rpx}
.drawer-mask {
  position:absolute;
  inset:0;
  background:#0008;
  display:flex;
  align-items:flex-end}
.drawer {
  width:100%;
  padding:30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  background:#171b25;
  border-radius:30rpx 30rpx 0 0}
.drawer-head,.auto {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:28rpx}
.drawer-head {
  font-size:34rpx;
  font-weight:600}
.drawer-head>view:last-child {
  font-size:26rpx;
  font-weight:400;
  padding:8rpx}
.drawer-count {
  font-size:24rpx;
  font-weight:400;
  color:#9ca7bd}
.auto {
  font-size:26rpx;
  color:#bbc4d6}
.drawer .chip {
  background:#262c3b;
  color:#c4cce0}
.drawer .chip.active {
  background:#7486ff;
  color:#fff}
.episode-scroll {
  max-height:48vh;
  height:490rpx}
.drawer .episode {
  background:#262c3b;
  color:#c4cce0}
.drawer .episode.current {
  background:#7486ff;
  color:#fff}
.drawer .episode.watched {
  color:#a2b1ff}

